<?php

/**
 * @file
 * Contains varbase_email.module.
 */

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\varbase_email\Hook\VarbaseEmailHooks;

/**
 * Implements hook_theme().
 */
#[LegacyHook]
function varbase_email_theme($existing, $type, $theme, $path) {
  return \Drupal::service(VarbaseEmailHooks::class)->theme($existing, $type, $theme, $path);
}

/**
 * Implements hook_preprocess_email().
 */
#[LegacyHook]
function varbase_email_preprocess_email(&$variables) {
  \Drupal::service(VarbaseEmailHooks::class)->preprocessEmail($variables);
}
