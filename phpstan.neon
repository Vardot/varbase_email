parameters:
  level: 0
  fileExtensions:
    - php
    - module
    - inc
    - install
    - theme
    - profile
  reportUnmatchedIgnoredErrors: false
  ignoreErrors:
    # new static() is a best practice in Drupal, so we cannot fix that.
    - '#^Unsafe usage of new static#'
    # theme_get_setting() is deprecated in drupal:11.3.0 and removed only in
    # drupal:13.0.0. varbase_email_preprocess_email() reads the per-theme email
    # logo / branding settings through it. The module's 10.1.x branch targets
    # the ~11.4.0 range where the function is fully available, and it is the
    # single code path that works across every supported core, so the
    # deprecation notice is expected and accepted here. Targeted rule exception,
    # not a generated phpstan baseline of the project's errors.
    -
      message: '#Call to deprecated function theme_get_setting\(\)#'
      path: varbase_email.module
