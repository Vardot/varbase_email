# Ignore node modules
node_modules
/*/node_modules

# Ignore yarn
.yarn/

# Ignore local gitlab-ci-local run artifacts (keep the .gitlab-ci-local.yml config).
.gitlab-ci-local/

# Ignore test run artifacts.
tests/reports/*
!tests/reports/.gitkeep
tests/screenshots/*
!tests/screenshots/.gitkeep
tests/videos/*
!tests/videos/.gitkeep

# JavaScript lockfiles are not committed: installs resolve from package.json
# (packageManager yarn@4.18.1, engines).
yarn.lock
package-lock.json
pnpm-lock.yaml
